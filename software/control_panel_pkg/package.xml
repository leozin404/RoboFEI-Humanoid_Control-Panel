<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>control_panel_pkg</name>
  <version>0.1.0</version>
  <description>
    Status aggregation logic for the RoboFEI control panel: USB presence
    monitoring, motor overload, GameController connection, and node
    heartbeats, consolidated into a single PanelStatus message.
  </description>
  <maintainer email="leosilva200311@gmail.com">Leonardo Aparecido da Silva</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>custom_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

